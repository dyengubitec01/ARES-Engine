# ============================================================
# RAG Search Server - Environment Configuration
# ============================================================
# 환경별 설정 파일을 생성하세요. APP_ENV에 따라 자동 로드됩니다.
# cp .env.example .env.dev    (개발 환경)
# cp .env.example .env.prod   (운영 환경)

# --- App ---
APP_ENV=dev                          # dev | prod
APP_HOST=0.0.0.0
APP_PORT=8006
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR

# --- Qdrant (Vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_CONTENT_FIELD=text_for_search         # payload에서 본문 텍스트를 담는 필드명

# --- Embedding API (BGE-M3) ---
EMBEDDING_API_URL=http://localhost:8100/query

# --- Reranker API ---
RERANKER_URL=http://localhost:8011/rerank

# --- Langfuse (Observability) ---
LANGFUSE_ENABLED=false                   # true: Langfuse 트레이싱 활성화, false: 비활성화
LANGFUSE_PUBLIC_KEY=                     # Langfuse 프로젝트 공개 키
LANGFUSE_SECRET_KEY=                     # Langfuse 프로젝트 비밀 키
LANGFUSE_HOST=https://cloud.langfuse.com # Langfuse 서버 호스트

# --- Search Parameters ---
SEARCH_K=20                          # 1차 벡터 검색 후보 수
TOP_K=6                              # 리랭킹 후 최종 반환 수
SCORE_THRESHOLD=0.0                  # 리랭킹 score 임계값 (0.0=필터링 없음, 0.01 권장)

# --- Hybrid Search (Dense + BM25 + RRF) ---
HYBRID_SEARCH_ENABLED=false          # text_for_search 필드에 full-text index 생성 후 true로 토글
RRF_K=60                             # Reciprocal Rank Fusion 상수 (표준값 60)

# --- Parent-document 인접 청크 확장 (실험적) ---
PARENT_EXPANSION_ENABLED=false       # true: 매칭 청크의 parent ±1 통째 회수·병합

# --- HTTP Client ---
HTTP_TIMEOUT=30.0                    # 외부 API 호출 타임아웃 (초)
