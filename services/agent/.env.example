# ===========================
# Environment
# ===========================
# 환경 구분 (dev / prod / test)
# OS 환경변수로 설정 시 해당 .env.{APP_ENV} 파일을 자동 로드
APP_ENV=dev

# ===========================
# Logging (ADR-004)
# ===========================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
# JSON 포맷 출력 (true: 운영, false: 개발 컬러 텍스트)
LOG_JSON_FORMAT=false
# 서비스 이름 (로그 파일명에 사용: agent.2026-03-04.log)
LOG_APP_NAME=agent
# 로그 파일 저장 디렉토리 (LOG_JSON_FORMAT=true 일 때만 파일 저장)
# 운영(Docker): /app/logs (호스트 ./logs 로 볼륨 마운트)
# 로컬 개발: ./logs
LOG_DIR=/app/logs
# 로그 보관 기간 (일)
LOG_RETENTION_DAYS=14

# ===========================
# LLM Server Configuration
# ===========================
# 로컬 개발 (Ollama):
# PRIMARY_LLM_BASE_URL=http://localhost:11434/v1
# SECONDARY_LLM_BASE_URL=http://localhost:11434/v1

# 운영 환경 (GPU 서버):
PRIMARY_LLM_BASE_URL=
SECONDARY_LLM_BASE_URL=

# 운영 서버 메인 GPU API 키
LLM_API_KEY=

# LLM 요청 타임아웃 (초)
# 로컬 Ollama: 120 (모델 로딩 시간 포함)
# 운영 GPU 서버: 10 (기본값)
LLM_TIMEOUT=10.0

# LLM 응답 최대 토큰 수
LLM_MAX_TOKENS=2048

# LLM 생성 temperature (0.0 ~ 1.0)
LLM_TEMPERATURE=0.6

# ===========================
# LangFuse Configuration (Optional - SDK v3)
# ===========================
# LangFuse V3 서버 연결 설정 (SDK v3 사용)
#
# 로컬 개발 (docker-compose.langfuse.yml 사용):
#   1. docker compose -f docker-compose.langfuse.yml up -d
#   2. http://localhost:3000 접속 후 회원가입
#   3. 프로젝트 생성 → Settings → API Keys에서 키 복사
#
# 프로덕션 (모니터링 서버):
#   LANGFUSE_HOST를 모니터링 서버 주소로 변경
#
# 트레이싱 on/off (true/false) - 키가 있어도 false면 비활성화
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 로컬 개발: http://localhost:3000
# 프로덕션: https://your-monitoring-server.com
LANGFUSE_HOST=http://localhost:3000

# LangFuse Prompt Management (프롬프트 관리 on/off)
# false로 설정하면 LangFuse API 호출 없이 코드 내 하드코딩 프롬프트 사용
LANGFUSE_PROMPT_ENABLED=true
LANGFUSE_PROMPT_CACHE_TTL=300

# ===========================
# Server Configuration
# ===========================
HOST=0.0.0.0
PORT=8000

# ===========================
# Response Configuration
# ===========================
# Chain of Thought(thoughts) 필드를 API 응답에 포함할지 여부
# 백엔드가 준비되면 true로 변경
INCLUDE_THOUGHTS_IN_RESPONSE=false

# ===========================
# Workflow Configuration
# ===========================
# 질문 재구성 건너뛰기 (true: 원본 query 그대로 사용)
SKIP_REWRITER=false
# RAG 검색 건너뛰기 (true: context 없이 LLM만 사용)
SKIP_RAG=false
# Tool 실행 건너뛰기 (true: 외부 도구 호출 없이 응답)
SKIP_TOOL=false
# Direct 경로 건너뛰기 (true: 모든 질문 RAG 경유)
SKIP_DIRECT=true

# ===========================
# RAG Configuration (Story 2.3, 2.8)
# ===========================
# Mock 클라이언트 사용 여부 (true: 개발용 Mock, false: 실제 RAG 서버)
USE_MOCK_RAG=true
# RAG 서버 기본 URL (USE_MOCK_RAG=false 일 때 사용)
# 로컬 개발: http://localhost:8006
# 운영 환경: http://your-rag-server:8006
RAG_BASE_URL=http://localhost:8006
# RAG 요청 타임아웃 (초)
RAG_TIMEOUT=10.0

# ===========================
# Tool Configuration (Story 2.4, 2.8)
# ===========================
# Mock 클라이언트 사용 여부 (true: 개발용 Mock, false: 실제 Tool 서버)
USE_MOCK_TOOL=true
# Tool 서버 기본 URL (USE_MOCK_TOOL=false 일 때 사용)
# 로컬 개발: http://localhost:8007
# 운영 환경: http://your-tool-server:8007
TOOL_BASE_URL=http://localhost:8007
# Tool 요청 타임아웃 (초) - 도구 실행은 오래 걸릴 수 있음
TOOL_TIMEOUT=30.0

# ===========================
# Model Configuration (Story 2.6)
# ===========================
# 모델 역할 설정 파일 경로
# - config/models.yaml: 운영 환경 (chat-gemma-27b 등 GPU 서버 모델)
# - config/models.dev.yaml: 개발 환경 (운영과 동일, 독립 변경 가능)
# - config/models.test.yaml: 로컬 테스트 (qwen2.5:7b 등 Ollama 모델)
MODEL_CONFIG_PATH=config/models.yaml
