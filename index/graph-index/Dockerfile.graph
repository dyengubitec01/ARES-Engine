# syntax=docker/dockerfile:1.6
# Graph_RAG_Index 빌드 이미지 = base(Vector_RAG_Index / EW) 런타임 이미지 + 그래프 오버레이.
#
# 설계: base 코드(config/models/embeddings/db/chunking 등)는 base 이미지에서 상속받고,
#       그래프 소스(scripts/graph_build 등)만 그 위에 얹는다. → 단방향 의존(graph → base).
# BASE_IMAGE 는 Jenkins가 dev=ew-dev:latest / prod=ew:latest 로 주입.
ARG BASE_IMAGE=registry.example.com/ares/ew-dev:latest
FROM ${BASE_IMAGE}

WORKDIR /app

# 그래프 전용 추가 의존 (base requirements 엔 없음)
RUN pip install --no-cache-dir "networkx>=3.1"

# 빌드 번호가 바뀌면 이 아래 레이어 캐시 무효화
ARG CACHE_BUST=0
# 그래프 소스를 base 코드 위에 오버레이 (config/models/embeddings 는 base 이미지 것 사용)
COPY . /app

CMD ["bash", "scripts/graph_build/run_pipeline.sh"]
